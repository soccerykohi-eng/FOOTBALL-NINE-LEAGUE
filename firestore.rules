rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 公開ポータルは誰でも閲覧可。変更は指定した運営Googleアカウントのみ。
    match /shared/{documentId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'soccerykohi@gmail.com';
    }
  }
}
